      "q": "She ___ already ___ her work.",
      "options": [
        "has / finish",
        "has / finished",
        "have / finished",
        "is / finishing"
      ],
      "answer": 1,
      "analysis": "第三人称单数用 has + 过去分词 finished。",
      "point": "g-s2u2",
      "source": "本单元语法课练习"
