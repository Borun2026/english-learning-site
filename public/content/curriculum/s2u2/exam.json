      "q": "I have ___ here since 2018.",
      "options": [
        "live",
        "lived",
        "living",
        "lives"
      ],
      "answer": 1,
      "analysis": "since + 时间点,现在完成时,用过去分词 lived。",
      "point": "g-s2u2",
      "source": "本单元语法课练习"
    },
    {
      "q": "___ you ever ___ to the Great Wall?",
      "options": [
        "Have / be",
        "Have / been",
        "Has / been",
        "Do / be"
      ],
      "answer": 1,
      "analysis": "ever 用于完成时疑问句,you 用 have + been。",
      "point": "g-s2u2",
      "source": "本单元语法课练习"
    },
    {
      "q": "He hasn't arrived ___.",
      "options": [
        "already",
        "just",
        "yet",
        "ever"
      ],
      "answer": 2,
      "analysis": "yet 用于否定句,放在句末。",
      "point": "g-s2u2",
      "source": "本单元语法课练习"
    },
    {
      "q": "They ___ just ___ lunch.",
      "options": [
        "has / had",
        "have / had",
        "had / had",
        "has / has"
      ],
      "answer": 1,
      "analysis": "主语 they 用 have,过去分词是 had。",
      "point": "g-s2u2",
      "source": "本单元语法课练习"
