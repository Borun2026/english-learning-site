      "source": "本单元语法课练习"
    },
    {
      "q": "The blue bike is ___.",
      "options": [
        "she",
        "her",
        "hers",
        "herself"
      ],
      "answer": 2,
      "analysis": "后面无名词,用名词性物主代词 hers。",
      "point": "g-s1u6",
      "source": "本单元语法课练习"
    },
    {
      "q": "Please help ___.",
      "options": [
        "he",
        "him",
        "his",
        "himself"
      ],
      "answer": 1,
      "analysis": "动词 help 后作宾语,用宾格 him。",
      "point": "g-s1u6",
      "source": "本单元语法课练习"
    },
