      "q": "\"开展研究\"的正确搭配是?",
      "options": [
        "do research",
        "conduct research",
        "make research",
        "research do"
      ],
      "answer": 1,
      "analysis": "conduct/carry out research 是标准搭配。",
      "point": "g-s5u5",
      "source": "本单元语法课练习"
    },
    {
      "q": "\"得出结论\"的正确表达是?",
      "options": [
        "make a conclusion",
        "draw a conclusion",
        "get a conclusion",
        "conclusion draw"
      ],
      "answer": 1,
      "analysis": "draw/reach a conclusion 是固定搭配。",
      "point": "g-s5u5",
      "source": "本单元语法课练习"
    },
    {
